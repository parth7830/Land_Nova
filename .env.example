# ===================================================
# LandNova Environment Configuration
# ===================================================

# Environment
ENVIRONMENT=development
DEBUG=true

# AI - Google Gemini API Key
# Optional for local demo (a high-fidelity deterministic engine is active by default)
GEMINI_API_KEY=

# Database Connection URL (SQLite default for zero-setup local run, PostGIS/PostgreSQL for production)
DATABASE_URL=sqlite:///./landnova.db
# DATABASE_URL=postgresql://user:password@localhost:5432/landnova

# API Prefix
API_PREFIX=/api

# Frontend URL for CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
